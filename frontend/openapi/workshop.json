{
  "openapi": "3.1.0",
  "info": {
    "title": "Bayflow Workshop API",
    "description": "Job cards for checked-in vehicles: inspection findings, recommended work and customer approval. Get a token from auth-service (POST /api/v1/auth/login) and use Authorize.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/v1/job-cards": {
      "get": {
        "tags": [
          "Job cards"
        ],
        "summary": "List job cards, newest first (customers see their own)",
        "operationId": "list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "INSPECTED",
                "AWAITING_APPROVAL",
                "APPROVED",
                "PARTIALLY_APPROVED",
                "DECLINED",
                "IN_PROGRESS",
                "COMPLETED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseJobCardSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Open the job card for a checked-in appointment",
        "description": "Idempotent on appointmentId: 201 when created, 200 with the existing card on a repeat.",
        "operationId": "open",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenJobCardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/work-logs": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Log work done on an approved recommendation (IN_PROGRESS)",
        "operationId": "logWork",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkLogRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/submit-for-approval": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "INSPECTED → AWAITING_APPROVAL (or DECLINED when nothing is recommended)",
        "operationId": "submit",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/start": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "APPROVED/PARTIALLY_APPROVED → IN_PROGRESS",
        "operationId": "start",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/recommendations": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Recommend work with a parts and labour estimate (OPEN/INSPECTED)",
        "operationId": "addRecommendation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/recommendations/{itemId}/decline": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Decline one recommendation (customer, or advisor on the customer's behalf)",
        "operationId": "decline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/recommendations/{itemId}/approve": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Approve one recommendation (customer, or advisor on the customer's behalf)",
        "operationId": "approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/parts": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Record a part used for an approved recommendation (IN_PROGRESS)",
        "operationId": "addPart",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/labour": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Record labour hours for an approved recommendation (IN_PROGRESS)",
        "description": "hourlyRate is optional and defaults to the workshop labour rate.",
        "operationId": "addLabour",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/findings": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "Record an inspection finding (OPEN/INSPECTED; the first moves OPEN → INSPECTED)",
        "operationId": "addFinding",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}/complete": {
      "post": {
        "tags": [
          "Job cards"
        ],
        "summary": "IN_PROGRESS/DECLINED → COMPLETED; calculates totals and writes the service history",
        "operationId": "complete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/service-history/vehicles/{vehicleId}": {
      "get": {
        "tags": [
          "Service history"
        ],
        "summary": "A vehicle's completed jobs, newest first",
        "description": "Customers see the entries for jobs on their own account.",
        "operationId": "forVehicle",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseServiceHistoryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/{id}": {
      "get": {
        "tags": [
          "Job cards"
        ],
        "summary": "A job card with findings, recommendations and estimates",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/job-cards/by-appointment/{appointmentId}": {
      "get": {
        "tags": [
          "Job cards"
        ],
        "summary": "The job card opened for an appointment",
        "operationId": "byAppointment",
        "parameters": [
          {
            "name": "appointmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OpenJobCardRequest": {
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string",
            "maxLength": 17,
            "minLength": 0
          },
          "registration": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "customerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "customerName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "mileage": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "appointmentId",
          "customerName",
          "mileage",
          "registration",
          "vehicleId",
          "vin"
        ]
      },
      "FindingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "recordedBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JobCardResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "appointmentId": {
            "type": "string",
            "format": "uuid"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          },
          "customerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "customerName": {
            "type": "string"
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "INSPECTED",
              "AWAITING_APPROVAL",
              "APPROVED",
              "PARTIALLY_APPROVED",
              "DECLINED",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            }
          },
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationResponse"
            }
          },
          "workLogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkLogResponse"
            }
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartResponse"
            }
          },
          "labour": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LabourResponse"
            }
          },
          "labourRate": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "estimatedTotal": {
            "type": "number"
          },
          "approvedEstimate": {
            "type": "number"
          },
          "partsTotal": {
            "type": "number"
          },
          "labourTotal": {
            "type": "number"
          },
          "grandTotal": {
            "type": "number"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LabourResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "mechanic": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "hourlyRate": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      },
      "PartResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "partNumber": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "type": "number"
          },
          "lineTotal": {
            "type": "number"
          },
          "recordedBy": {
            "type": "string"
          }
        }
      },
      "RecommendationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "estimatedPartsCost": {
            "type": "number"
          },
          "estimatedLabourHours": {
            "type": "number"
          },
          "estimatedLabourCost": {
            "type": "number"
          },
          "estimatedTotal": {
            "type": "number"
          },
          "approvalStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "DECLINED"
            ]
          },
          "decidedBy": {
            "type": "string"
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkLogResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "mechanic": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkLogRequest": {
        "type": "object",
        "properties": {
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "description",
          "recommendationId"
        ]
      },
      "RecommendationRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          },
          "estimatedPartsCost": {
            "type": "number",
            "minimum": 0
          },
          "estimatedLabourHours": {
            "type": "number",
            "maximum": 999.99,
            "minimum": 0
          }
        },
        "required": [
          "description",
          "estimatedLabourHours",
          "estimatedPartsCost"
        ]
      },
      "PartRequest": {
        "type": "object",
        "properties": {
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "partNumber": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "maximum": 1000,
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "partNumber",
          "quantity",
          "recommendationId",
          "unitPrice"
        ]
      },
      "LabourRequest": {
        "type": "object",
        "properties": {
          "recommendationId": {
            "type": "string",
            "format": "uuid"
          },
          "hours": {
            "type": "number",
            "maximum": 24,
            "minimum": 0.01
          },
          "hourlyRate": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "hours",
          "recommendationId"
        ]
      },
      "FindingRequest": {
        "type": "object",
