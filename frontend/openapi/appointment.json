  },
  "components": {
    "schemas": {
      "UpdateVehicleRequest": {
        "type": "object",
        "properties": {
          "registration": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "make": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "maximum": 2100,
            "minimum": 1900
          },
          "mileage": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "make",
          "mileage",
          "model",
          "registration",
          "year"
        ]
      },
      "VehicleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9 ()\\-]{5,30}$"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateVehicleRequest": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?i)^[A-HJ-NPR-Z0-9]{17}$"
          },
          "registration": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "make": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "maximum": 2100,
            "minimum": 1900
          },
          "mileage": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "make",
          "mileage",
          "model",
          "registration",
          "vin",
          "year"
        ]
      },
      "CreateCustomerRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9 ()\\-]{5,30}$"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "BookAppointmentRequest": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "maximum": 480,
            "minimum": 15
          },
          "serviceType": {
            "type": "string",
            "enum": [
              "ROUTINE_SERVICE",
              "OIL_CHANGE",
              "INSPECTION",
              "BRAKES",
              "TYRES",
              "DIAGNOSTIC",
              "REPAIR",
              "OTHER"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "scheduledAt",
          "serviceType",
          "vehicleId"
        ]
      },
      "AppointmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "customerName": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleSummary"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "serviceType": {
            "type": "string",
            "enum": [
              "ROUTINE_SERVICE",
              "OIL_CHANGE",
              "INSPECTION",
              "BRAKES",
              "TYRES",
              "DIAGNOSTIC",
              "REPAIR",
              "OTHER"
            ]
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "CONFIRMED",
              "ARRIVED",
              "CHECKED_IN",
              "CANCELLED",
              "NO_SHOW"
            ]
          },
          "arrivalMileage": {
            "type": "integer",
