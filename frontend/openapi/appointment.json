{
  "openapi": "3.1.0",
  "info": {
    "title": "Bayflow Appointment API",
    "description": "Customers, vehicles and service appointments from booking to check-in. Get a token from auth-service (POST /api/v1/auth/login) and use Authorize.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "paths": {
