{
  "name": "bayflow-web",
  "private": true,
  "version": "0.1.0",
  "description": "Ramplight web app (codename Bayflow): the smarter way to run your auto workshop.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:pull": "node scripts/pull-openapi.mjs",
    "api:gen": "openapi-typescript openapi/auth.json -o src/api/schema/auth.ts && openapi-typescript openapi/appointment.json -o src/api/schema/appointment.ts && openapi-typescript openapi/workshop.json -o src/api/schema/workshop.ts",
    "api:update": "pnpm api:pull && pnpm api:gen",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "demo:record": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "~8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.6",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw"
    ]
  }
}
