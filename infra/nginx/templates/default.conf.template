# Bayflow web: serves the React app and routes /api/v1/* to the three services, so the
# browser sees a single origin (no CORS; the refresh-token cookie just works).
#
# ${AUTH_UPSTREAM}, ${APPOINTMENT_UPSTREAM} and ${WORKSHOP_UPSTREAM} are filled in from the
# environment when the container starts (nginx image template support).

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/problem+json image/svg+xml;

    # ---- API routes -------------------------------------------------------------------

    location /api/v1/auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    location = /.well-known/jwks.json {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    location ~ ^/api/v1/(customers|vehicles|appointments)(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${APPOINTMENT_UPSTREAM};
    }

    location ~ ^/api/v1/(job-cards|service-history)(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${WORKSHOP_UPSTREAM};
    }

    # Anything else under /api is not a Bayflow endpoint.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/problem+json;
        return 404 '{"type":"urn:bayflow:problem:not-found","title":"Not Found","status":404}';
    }

    # ---- the app --------------------------------------------------------------------------

    # Built assets have content hashes in their names: cache them for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Every other path is a page of the single-page app: serve index.html, never cached,
    # so a new release is picked up on the next visit.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
