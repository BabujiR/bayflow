# Bayflow web: serves the React app and routes /api/v1/* to the four services, so the
# browser sees a single origin (no CORS; the refresh-token cookie just works).
#
# Every host is served: the bare base domain (localhost:3000) is the public sign-up site, and
# each workshop has its own address (<slug>.localhost:3000). The browser's host goes to the
# services in X-Forwarded-Host (snippets/proxy.conf); they decide the workshop from it.
#
# ${AUTH_UPSTREAM}, ${APPOINTMENT_UPSTREAM}, ${WORKSHOP_UPSTREAM} and ${NOTIFICATION_UPSTREAM} are filled in from the
# environment when the container starts (nginx image template support).

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/problem+json image/svg+xml;

    # ---- API routes -------------------------------------------------------------------

    # Service-to-service endpoints: services call auth-service directly, never through nginx.
    location /api/v1/auth/internal/ {
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/problem+json;
        return 404 '{"type":"urn:bayflow:problem:not-found","title":"Not Found","status":404}';
    }

    # Branding (and its image uploads: logo up to 1 MB, cover up to 3 MB, plus multipart
    # overhead). auth-service checks each image's own limit; everything else stays at 1 MB.
    # A regex, not the prefix "/api/v1/auth/tenant/branding/": with proxy_pass, nginx answers
    # the path without the trailing slash with a 301 to the slashed one (on its internal port).
    location ~ ^/api/v1/auth/tenant/branding(/|$) {
        client_max_body_size 4m;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    location /api/v1/auth/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    # A workshop's logos, icon and sign-in cover photo: public and cacheable (auth-service sets
    # Cache-Control and ETag), unlike every other API response.
    location ~ ^/api/v1/tenants/current/(logo|logo-dark|icon|cover)$ {
        include /etc/nginx/snippets/proxy-pass.conf;
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    # Workshop sign-up, address check and the public workshop name (auth-service).
    location /api/v1/tenants/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    location = /.well-known/jwks.json {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${AUTH_UPSTREAM};
    }

    location ~ ^/api/v1/(customers|vehicles|appointments)(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${APPOINTMENT_UPSTREAM};
    }

    location ~ ^/api/v1/(job-cards|service-history|reports|invoices)(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${WORKSHOP_UPSTREAM};
    }

    # Each user's notifications. (/api/v1/internal/ is never routed: services call each other directly.)
    location ~ ^/api/v1/notifications(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${NOTIFICATION_UPSTREAM};
    }

    # Anything else under /api is not a Bayflow endpoint.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/problem+json;
        return 404 '{"type":"urn:bayflow:problem:not-found","title":"Not Found","status":404}';
    }

    # ---- the app --------------------------------------------------------------------------

    # Built assets have content hashes in their names: cache them for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Every other path is a page of the single-page app: serve index.html, never cached,
    # so a new release is picked up on the next visit.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
