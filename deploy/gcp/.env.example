# Settings for the GCP VM (docker-compose.yml in this folder). Copy to .env on the VM:
#   cp .env.example .env
# scripts/setup-vm.sh fills in every empty password and secret below with a random value.
# Never commit .env. Keep a copy in your password manager: you need it to restore a backup.

# --- Domain -----------------------------------------------------------------------------
# The sign-up site is https://<domain>; each workshop is at https://<slug>.<domain>.
BAYFLOW_BASE_DOMAIN=getramplight.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=
# Cloudflare API token with only "Zone > DNS > Edit" on this domain (docs/GCP-DEPLOY.md, step 4).
CLOUDFLARE_API_TOKEN=

# --- Images -----------------------------------------------------------------------------
# Published by .github/workflows/cd.yml: ghcr.io/<your GitHub user or org, lower case>.
IMAGE_PREFIX=ghcr.io/your-github-user
# "latest", or a commit SHA to pin a version (and to roll back).
IMAGE_TAG=latest

# --- Database ---------------------------------------------------------------------------
POSTGRES_DB=bayflow
POSTGRES_USER=bayflow
POSTGRES_PASSWORD=
# The services' runtime login (row-level security applies to it).
BAYFLOW_APP_DB_PASSWORD=

# --- Service-to-service secrets ----------------------------------------------------------
BAYFLOW_SYSTEM_CLIENT_SECRET=
BAYFLOW_WORKSHOP_CLIENT_SECRET=
BAYFLOW_NOTIFICATION_CLIENT_SECRET=

# --- First admin --------------------------------------------------------------------------
# Created at the first start, in the default workshop, while no admin exists.
BAYFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
BAYFLOW_BOOTSTRAP_ADMIN_EMAIL=
BAYFLOW_BOOTSTRAP_ADMIN_PASSWORD=

# --- E-mail ("Forgot password?" links) ---------------------------------------------------
# Empty host = no e-mail: the sign-in page then says to ask the workshop for a reset.
# Gmail (demos): a separate Gmail account with 2-Step Verification and an App Password.
#   BAYFLOW_MAIL_HOST=smtp.gmail.com, PORT=587, USERNAME and FROM = the Gmail address,
#   PASSWORD = the 16-character App Password, without spaces. About 500 e-mails a day.
# Later (SES, SendGrid, Mailgun): their SMTP host, user and password, and
#   BAYFLOW_MAIL_FROM=no-reply@<your domain>, after adding their DNS records in Cloudflare.
BAYFLOW_MAIL_HOST=
BAYFLOW_MAIL_PORT=587
BAYFLOW_MAIL_USERNAME=
BAYFLOW_MAIL_PASSWORD=
BAYFLOW_MAIL_FROM=

# --- Demo requests (getramplight.com "Request a demo") ---
# Who gets each request by e-mail (needs the mail settings above). Empty: stored in the database only.
BAYFLOW_DEMO_NOTIFY_EMAIL=

# --- Ramplight console (<base domain>/console) ---
# The first platform admin is created once at start-up when the password is set; with it empty, no
# console account is made. Sign in at /console and change the password; later restarts leave it alone.
# The e-mail must not belong to any workshop account (e-mails are unique across Ramplight).
BAYFLOW_PLATFORM_ADMIN_USERNAME=ramplight
BAYFLOW_PLATFORM_ADMIN_EMAIL=
BAYFLOW_PLATFORM_ADMIN_PASSWORD=

# --- QuickBooks Online ----------------------------------------------------------------------
# Off while empty. Intuit app keys (developer.intuit.com); production keys need Intuit's app
# review, until then use the development keys with ENVIRONMENT=sandbox. Register this redirect
# URI at Intuit: https://<BAYFLOW_BASE_DOMAIN>/api/v1/quickbooks/callback
BAYFLOW_QBO_CLIENT_ID=
BAYFLOW_QBO_CLIENT_SECRET=
BAYFLOW_QBO_ENVIRONMENT=sandbox
# openssl rand -base64 32 (keep it safe; changing it means reconnecting QuickBooks)
BAYFLOW_QBO_TOKEN_KEY=

# --- Workshops ----------------------------------------------------------------------------
# Starting settings of a new workshop; each workshop's ADMIN then sets its own.
BAYFLOW_WORKSHOP_ZONE=America/New_York
BAYFLOW_CURRENCY=USD
BAYFLOW_LABOUR_RATE=95.00
# Workshop sign-ups allowed per IP address per hour.
BAYFLOW_SIGNUP_MAX_PER_HOUR=10
# How long a setup invite from the console works (ISO-8601 duration).
BAYFLOW_INVITE_TTL=P7D

# --- Backups (scripts/backup.sh) -----------------------------------------------------------
# Cloud Storage bucket for the nightly database dump, without gs:// (docs/GCP-DEPLOY.md, step 2).
BACKUP_BUCKET=
