# Copy to .env and adjust. docker compose reads .env automatically.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=bayflow
POSTGRES_USER=bayflow
POSTGRES_PASSWORD=bayflow
# Host port; change if 5432 is already used on your machine
POSTGRES_PORT=5432

# --- Workshop settings (used from milestone 3) ---
BAYFLOW_WORKSHOP_ZONE=America/New_York
BAYFLOW_CURRENCY=USD
BAYFLOW_LABOUR_RATE=95.00

# --- Auth service ---
AUTH_PORT=8083
# dev = seed demo users (customer1 / advisor1 / mechanic1)
SPRING_PROFILES_ACTIVE=dev
# Secret appointment-service uses to get SYSTEM tokens. Change it outside local dev.
BAYFLOW_SYSTEM_CLIENT_SECRET=dev-system-secret
# First ADMIN account, created at startup only while no admin exists. Leave empty to skip.
BAYFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
BAYFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@bayflow.local
BAYFLOW_BOOTSTRAP_ADMIN_PASSWORD=
# Optional stable signing key: run scripts/generate-dev-keys.(sh|ps1), then uncomment.
# BAYFLOW_JWT_PRIVATE_KEY_PATH=/run/keys/dev-private.pem
# BAYFLOW_JWT_PUBLIC_KEY_PATH=/run/keys/dev-public.pem
