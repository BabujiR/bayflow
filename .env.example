# Copy to .env and adjust. docker compose reads .env automatically.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=bayflow
POSTGRES_USER=bayflow
POSTGRES_PASSWORD=bayflow
# Password of bayflow_app, the login the services use (row-level security applies to it).
# Changing it on an existing database: run scripts/upgrade-local-db.(sh|ps1) afterwards.
BAYFLOW_APP_DB_PASSWORD=bayflow_app
# Host port; change if 5432 is already used on your machine
POSTGRES_PORT=5432

# --- Appointment service ---
APPOINTMENT_PORT=8081

# --- Workshop service ---
WORKSHOP_PORT=8082

# --- Workshop settings defaults ---
# Each workshop's ADMIN sets its own labour rate, currency and time zone (Workshop settings page).
# These only seed a workshop that has no settings yet, and fill records from before phase 3.
BAYFLOW_WORKSHOP_ZONE=America/New_York
BAYFLOW_CURRENCY=USD
BAYFLOW_LABOUR_RATE=95.00

# --- Auth service ---
AUTH_PORT=8083
# dev = seed demo users (customer1 / advisor1 / mechanic1)
SPRING_PROFILES_ACTIVE=dev
# Secret appointment-service uses to get SYSTEM tokens. Change it outside local dev.
BAYFLOW_SYSTEM_CLIENT_SECRET=dev-system-secret
# Secret workshop-service uses to get SYSTEM tokens (to read workshop settings).
BAYFLOW_WORKSHOP_CLIENT_SECRET=dev-workshop-secret
BAYFLOW_NOTIFICATION_CLIENT_SECRET=dev-notification-secret
# First ADMIN account, created at startup only while no admin exists. Leave empty to skip.
BAYFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
BAYFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@bayflow.local
BAYFLOW_BOOTSTRAP_ADMIN_PASSWORD=
# Optional stable signing key: run scripts/generate-dev-keys.(sh|ps1), then uncomment.
# BAYFLOW_JWT_PRIVATE_KEY_PATH=/run/keys/dev-private.pem
# BAYFLOW_JWT_PUBLIC_KEY_PATH=/run/keys/dev-public.pem

# --- Workshops (SaaS) ---
# Each workshop is at <slug>.<base domain>; the base domain itself is the sign-up site.
# Locally: http://localhost:3000 (sign up), http://demo.localhost:3000, http://acme.localhost:3000
BAYFLOW_BASE_DOMAIN=localhost
# Workshop used at addresses without one (Swagger UI on :8083). Leave empty outside local dev.
BAYFLOW_FALLBACK_WORKSHOP=demo
# Workshop sign-ups allowed per IP per hour (30 locally so repeated e2e runs fit; lower in production).
BAYFLOW_SIGNUP_MAX_PER_HOUR=30

# --- E-mail ("Forgot password?" links) ---
# Locally every e-mail goes to Mailpit: http://localhost:8025 (MAILPIT_PORT to change the port).
# To send real e-mail instead, set BAYFLOW_MAIL_HOST, _PORT, _USERNAME, _PASSWORD, _FROM,
# BAYFLOW_MAIL_SMTP_AUTH=true and BAYFLOW_MAIL_STARTTLS=true (see deploy/gcp/.env.example).

# --- Demo requests (getramplight.com "Request a demo") ---
# Who gets each request by e-mail (needs the mail settings above). Empty: stored in the database only.
BAYFLOW_DEMO_NOTIFY_EMAIL=

# --- Ramplight console (<base domain>/console) ---
# The first platform admin is created once at start-up when the password is set; with it empty, no
# console account is made. Sign in at /console and change the password; later restarts leave it alone.
# The e-mail must not belong to any workshop account (e-mails are unique across Ramplight).
BAYFLOW_PLATFORM_ADMIN_USERNAME=ramplight
BAYFLOW_PLATFORM_ADMIN_EMAIL=
BAYFLOW_PLATFORM_ADMIN_PASSWORD=

# --- QuickBooks Online (invoices, payments and voids from the invoice page) ---
# Off while these are empty. Keys from an app at developer.intuit.com (development keys work with
# sandbox companies only). Register the redirect URI below at Intuit exactly as written.
BAYFLOW_QBO_CLIENT_ID=
BAYFLOW_QBO_CLIENT_SECRET=
BAYFLOW_QBO_ENVIRONMENT=sandbox
BAYFLOW_QBO_REDIRECT_URI=http://localhost:3000/api/v1/quickbooks/callback
# openssl rand -base64 32 — encrypts the QuickBooks tokens in the database. Keep it: changing it
# means connecting QuickBooks again.
BAYFLOW_QBO_TOKEN_KEY=

# --- Web app (nginx) ---
# http://localhost:3000
WEB_PORT=3000
