# Copy to .env and adjust. docker compose reads .env automatically.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=bayflow
POSTGRES_USER=bayflow
POSTGRES_PASSWORD=bayflow
# Host port; change if 5432 is already used on your machine
POSTGRES_PORT=5432

# --- Workshop settings (used from milestone 3) ---
BAYFLOW_WORKSHOP_ZONE=America/New_York
BAYFLOW_CURRENCY=USD
BAYFLOW_LABOUR_RATE=95.00

# --- Auth (used from milestone 2) ---
# BAYFLOW_JWT_PRIVATE_KEY_PATH=./keys/dev-private.pem
# BAYFLOW_JWT_PUBLIC_KEY_PATH=./keys/dev-public.pem
# BAYFLOW_SYSTEM_CLIENT_SECRET=change-me
